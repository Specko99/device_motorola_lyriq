import /tee.rc
import /trustonic.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64

on post-fs
    # Set correct handle of ufs preloader boot regions
    symlink /dev/block/sda /dev/block/by-name/preloader_a
    symlink /dev/block/sdb /dev/block/by-name/preloader_b

service vendor.boot-default /vendor/bin/hw/android.hardware.boot-service.mtk
    class hal
    user root
    group root
    seclabel u:r:recovery:s0

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0
    
on property:twrp.decrypt.done=true
    stop mobicore
    stop vendor.gatekeeper-default
    stop vendor.keymint-trustonic

on boot
    start vendor.boot-default
    start vendor.vibrator-default
    start vendor.gatekeeper-default
    start vendor.keymint-trustonic
